# One hostname, TLS automatic via Caddy.
#   POST /csp    → public report endpoint
#   /admin/...   → GUI (the app enforces basic auth via gui_password)
csp.example.com {
	request_body {
		# Must not undercut IngestApp::MAX_BODY — a 413 here makes the browser
		# back off the endpoint and silently drop its queued report batch.
		max_size 256KB
	}
	reverse_proxy 127.0.0.1:9292
}
