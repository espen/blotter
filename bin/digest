#!/usr/bin/env ruby
# Daily digest: prune old rows, mail only when new keys appeared.
# Cron: 0 6 * * * cd /path/to/blotter && bundle exec bin/digest
require "net/smtp"
require "securerandom"
require "time"
require_relative "../lib/collector"

store = Collector.store
store.prune!(days: Collector.config.fetch("prune_days", 90))

rows = store.new_since(Time.now - 24 * 3600)
exit 0 if rows.empty?

cfg = Collector.config
digest = cfg.fetch("digest")
max = digest.fetch("max_new_keys")

# Plain text only — these strings are attacker-controlled (Troy #2).
lines = rows.first(max).map do |r|
  badge = r["bucket"] == "unattributed_inline" ? " [UNATTRIBUTED INLINE]" : ""
  badge += " [REPORT-ONLY]" if r["disposition"] == "report"
  # A blocked value that only repeats the document host (every NEL row) says
  # nothing the "on <host>" part doesn't — same rule as "self" in the GUI.
  blocked = r["blocked_key"] == r["document_host"] ? "" : r["blocked_key"]
  on = r["document_host"].to_s.empty? ? "" : "on #{r["document_host"]}"
  ["#{r["count"]}x", r["type"], r["directive"], blocked, on].reject { |part| part.to_s.empty? }.join(" ") + badge
end
lines << "... and #{rows.size - max} more" if rows.size > max

from = digest.fetch("from")
to = digest.fetch("to")
# Optional: where the GUI lives, so the mail can link to it.
review = ["Review in the Blotter GUI: ignore the noise, dig into the samples.", digest["gui_url"]]
message = <<~MAIL
  From: Blotter <#{from}>
  To: #{to}
  Subject: Blotter: #{rows.size} new report key(s)
  Date: #{Time.now.rfc2822}
  Message-ID: <#{SecureRandom.hex(16)}@#{from[/@([^>\s]+)/, 1] || "blotter.invalid"}>
  Content-Type: text/plain; charset=utf-8

  New violation keys in the last 24h (inline first, then by count):

  #{lines.join("\n")}

  #{review.compact.join("\n")}
MAIL

smtp_cfg = cfg.fetch("smtp")
smtp = Net::SMTP.new(smtp_cfg.fetch("host"), smtp_cfg.fetch("port"))
smtp.enable_starttls if smtp_cfg["starttls"]
args = smtp_cfg["user"] ? [smtp_cfg["user"], smtp_cfg["password"], :plain] : []
smtp.start("blotter", *args) { |s| s.send_message(message, from, to) }
