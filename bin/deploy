#!/bin/sh
# Deploy the latest commit. Run on the server, or from anywhere:
#   ssh <host> /opt/blotter/bin/deploy
# Requires a sudoers rule so the app user may restart the service:
#   cspcollector ALL=(root) NOPASSWD: /usr/bin/systemctl restart blotter
set -e
cd "$(dirname "$0")/.."

before=$(git rev-parse --short HEAD)
git pull --ff-only
after=$(git rev-parse --short HEAD)

if [ "$before" = "$after" ]; then
  echo "Already at $after — nothing to deploy."
  exit 0
fi

# Use mise's Ruby when installed for this user; gems in vendor/bundle if present
BUNDLE="bundle"
[ -x "$HOME/.local/bin/mise" ] && BUNDLE="$HOME/.local/bin/mise exec -- bundle"
[ -d vendor/bundle ] && export BUNDLE_PATH=vendor/bundle

$BUNDLE install --quiet
sudo -n systemctl restart blotter
echo "Deployed $before -> $after"
